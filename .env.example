# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
BETTER_AUTH_URL=http://localhost:3000
# Generate with `npx auth secret`; use at least 32 characters.
BETTER_AUTH_SECRET=
LOG_LEVEL=info
# Optional: persistent folder for lesson attachments (defaults to .local/attachments).
ATTACHMENTS_DIR=
# Optional: set to s3 to store attachments in an S3-compatible private bucket.
ATTACHMENTS_STORE=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
